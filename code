plot_data = cleaned_df.copy()
plot_data['Sex'] = plot_data['Sex'].replace({1: 'Male', 2: 'Female', '1': 'Male', '2': 'Female'})
bubble_data = plot_data.groupby(['Reaction', 'Sex']).agg({
    'Patient_Age': 'mean',
    'Drug': 'count'  # Count as size
}).reset_index()
bubble_data.columns = ['Reaction', 'Sex', 'Avg_Age', 'Count']
for sex, color in zip(['Male', 'Female'], ['#66b3ff', '#ff9999']):
    data = bubble_data[bubble_data['Sex'] == sex]
    plt.scatter(data['Avg_Age'], data['Reaction'], s=data['Count']*2,
                alpha=0.6, c=color, label=sex, edgecolors='black', linewidth=1)

plt.title('Reaction by Average Age and Sex (Bubble Size = Frequency)', fontsize=16, fontweight='bold')
plt.xlabel('Average Patient Age', fontsize=12)
plt.ylabel('Reaction Type', fontsize=12)
plt.legend(title='Sex', fontsize=10)
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.show()

top_drug = cleaned_df['Drug'].mode()[0]
print(f"Generating Heatmap for the Top Drug: {top_drug}")

# 2. Filter data for ONLY this drug
drug_data = cleaned_df[cleaned_df['Drug'] == top_drug].copy()

# 3. Ensure 'Sex' is labeled correctly (Male/Female)
drug_data['Sex'] = drug_data['Sex'].replace({1: 'Male', 2: 'Female', '1': 'Male', '2': 'Female'})
# Filter for only Male/Female to keep the chart clean
drug_data = drug_data[drug_data['Sex'].isin(['Male', 'Female'])]

# 4. Create Age Groups (Bins)
# We group ages into 10-year buckets (0-10, 10-20, etc.) so the heatmap is readable
drug_data['Age_Group'] = pd.cut(drug_data['Patient_Age'], bins=range(0, 101, 10), right=False)

# 5. Create the Cross-Tabulation (Matrix)
# Rows = Age Groups, Columns = Sex
age_sex_matrix = pd.crosstab(drug_data['Age_Group'], drug_data['Sex'])

# 6. Plot the Heatmap

plt.figure(figsize=(8, 6))
sns.heatmap(age_sex_matrix, annot=True, fmt='d', cmap='Oranges', linewidths=1)

plt.title(f'Age vs. Sex Distribution for {top_drug}')
plt.ylabel('Age Group')
plt.xlabel('Gender')
plt.show()
