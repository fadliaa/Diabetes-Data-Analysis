analysis_df = cleaned_df.copy()

# 2. Fix the labels ONLY for this analysis
# We replace 1 -> Male and 2 -> Female
analysis_df['Sex'] = analysis_df['Sex'].replace({
    1: 'Male',
    2: 'Female',
    '1': 'Male',
    '2': 'Female'
})

# 3. Filter for only Male and Female (removing '0', 'Unknown', etc.)
gender_df = analysis_df[analysis_df['Sex'].isin(['Male', 'Female'])]

# 4. CALCULATE THE WINNERS
if not gender_df.empty:
    top_reaction_male = gender_df[gender_df['Sex'] == 'Male']['Reaction'].mode()[0]
    top_reaction_female = gender_df[gender_df['Sex'] == 'Female']['Reaction'].mode()[0]

    print(f"Most Common Reaction in MALES:   {top_reaction_male}")
    print(f"Most Common Reaction in FEMALES: {top_reaction_female}")

    # 5. VISUALIZE WITH HEATMAP
    # Focus on Top 10 Reactions to keep the chart readable
    top_10_reactions = gender_df['Reaction'].value_counts().nlargest(10).index
    heatmap_data = gender_df[gender_df['Reaction'].isin(top_10_reactions)]

    # Create the Matrix (Counts)
    crosstab = pd.crosstab(heatmap_data['Reaction'], heatmap_data['Sex'], normalize='columns') * 100

    plt.figure(figsize=(8, 6))
    sns.heatmap(crosstab, annot=True, fmt='.1f', cmap='Reds', linewidths=0.5)

    plt.title('Top Side Effects: Male vs. Female (%)')
    plt.xlabel('Gender')
    plt.ylabel('Side Effect')
    plt.show()

else:
    print("Error: No 'Male' or 'Female' found. Please check your data values.")

